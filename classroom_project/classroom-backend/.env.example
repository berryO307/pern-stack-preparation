# Get your connection string from the Neon Console:
# Project -> Dashboard -> Connect
DATABASE_URL="postgresql://username:password@ep-something.neon.tech/neondb?sslmode=require"

# Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials
# -> Create OAuth client ID -> Web application). Add this as an Authorized
# redirect URI, using your actual backend origin:
#   {BACKEND_ORIGIN}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth (github.com/settings/developers -> New OAuth App).
# Authorization callback URL:
#   {BACKEND_ORIGIN}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Comma-separated, case-insensitive. Any of these emails signing in via
# Google/GitHub gets role="admin" automatically on account creation — see
# databaseHooks.user.create.before in lib/auth.ts.
ADMIN_EMAILS=""
