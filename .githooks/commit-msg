#!/usr/bin/env bash
# Enforces Conventional Commits: type(scope): subject
# Allowed types: feat fix docs chore refactor test perf build ci

msg_file="$1"
subject=$(head -1 "$msg_file")

# Merge/revert commits are generated by git/GitHub in their own format,
# not typed by a contributor - never subject to this check.
if echo "$subject" | grep -qE '^(Merge |Revert )'; then
    exit 0
fi

pattern='^(feat|fix|docs|chore|refactor|test|perf|build|ci)(\([a-zA-Z0-9_.-]+\))?: [a-z0-9].*[^. ]$'

if ! echo "$subject" | grep -qE "$pattern"; then
    echo "commit-msg: subject line doesn't match Conventional Commits format."
    echo ""
    echo "  Expected: type(scope): subject"
    echo "  Types:    feat fix docs chore refactor test perf build ci"
    echo "  Rules:    imperative mood, lower case after the colon, no trailing period"
    echo ""
    echo "  Got: $subject"
    exit 1
fi

if [ "${#subject}" -gt 72 ]; then
    echo "commit-msg: subject line is ${#subject} characters, over the 72 cap."
    echo "  $subject"
    exit 1
fi

exit 0
